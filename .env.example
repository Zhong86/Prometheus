# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── AstraDB ──────────────────────────────────────────────────────────────────
ASTRA_DB_TOKEN=
ASTRA_DB_ENDPOINT=
ASTRA_DB_KEYSPACE=

# ── Search APIs ──────────────────────────────────────────────────────────────
SERPAPI_KEY=
TAVILY_API_KEY=

# ── Langflow ─────────────────────────────────────────────────────────────────
# Base URL of the running Langflow instance (default: local Docker service)
LANGFLOW_BASE_URL=http://localhost:7860
# Flow ID copied from the Langflow UI after importing athena_research_flow.json
LANGFLOW_FLOW_ID=
# Only needed if Langflow auth is on (LANGFLOW_AUTO_LOGIN=false); sent as x-api-key
LANGFLOW_API_KEY=

# Frontend (Next.js) -> backend URL; only set if the backend is not on localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
